<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the extension's midnight canvas so there is no white flash before Moodle paints -->
    <style name="Theme.BetterMoodle" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
